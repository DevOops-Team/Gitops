{
  "schema_version": 1,
  "event_source": "kafka",
  "mode": "execute",
  "execution_enabled": true,
  "aws_region": "us-east-2",
  "recovery_table": "devoops-prod-recovery",
  "fencing_table": "devoops-prod-fencing",
  "kafka_bootstrap_servers": "172.30.0.40:9092,172.30.0.41:9092,172.30.0.42:9092",
  "kafka_group_id": "recovery-controller-v1",
  "fault_topic": "gpu.fault",
  "result_topic": "recovery.action",
  "redispatch_policy": "controller-only",
  "scheduler_policy_confirmed": true,
  "job_namespace": "training",
  "reconcile_seconds": 5,
  "straggler_auto_migration_enabled": false,
  "watchdog": {
    "enabled": false
  },
  "relocation_status_input": {
    "enabled": true,
    "producer_contract_confirmed": true
  },
  "fencing_progress_input": {
    "enabled": true,
    "producer_contract_confirmed": true,
    "attribute": "recovery_training_evidence"
  },
  "retry_policy": {
    "api_attempts": 3,
    "claim_timeout_seconds": 300,
    "stop_timeout_seconds": 900,
    "submit_timeout_seconds": 900,
    "resume_timeout_seconds": 1800,
    "kafka_backoff_seconds": 5,
    "kafka_max_backoff_seconds": 300,
    "max_recovery_attempts": 3,
    "job_failed_wait_seconds": 300
  },
  "evidence_policy": {
    "max_age_seconds": 300,
    "future_skew_seconds": 30,
    "placement_producers": [
      "scheduling",
      "job-watcher"
    ],
    "progress_producers": [
      "training"
    ]
  },
  "backend_metadata": {
    "enabled": false,
    "base_url": "https://backend-recovery.platform.svc:8443",
    "token_env": "BACKEND_RECOVERY_API_TOKEN",
    "timeout_seconds": 5,
    "max_age_seconds": 300,
    "future_skew_seconds": 30
  }
}
